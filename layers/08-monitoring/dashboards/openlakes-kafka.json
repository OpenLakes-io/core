{
  "dashboard": {
    "title": "OpenLakes - Kafka Streaming",
    "tags": ["openlakes", "kafka", "streaming"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 1,
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
        "type": "stat",
        "title": "Kafka Brokers",
        "targets": [{
          "expr": "count(kafka_server_broker_state)",
          "refId": "A"
        }],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "green"}
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
        "type": "stat",
        "title": "Total Topics",
        "targets": [{
          "expr": "count(kafka_topic_partitions)",
          "refId": "A"
        }],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "green"}
              ]
            }
          }
        }
      },
      {
        "id": 3,
        "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
        "type": "stat",
        "title": "Consumer Groups",
        "targets": [{
          "expr": "count(kafka_consumergroup_members)",
          "refId": "A"
        }],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "green"}
              ]
            }
          }
        }
      },
      {
        "id": 4,
        "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
        "type": "stat",
        "title": "Under Replicated Partitions",
        "targets": [{
          "expr": "sum(kafka_topic_partition_under_replicated_partition)",
          "refId": "A"
        }],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "green"},
                {"value": 1, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 5,
        "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
        "type": "graph",
        "title": "Messages In Rate",
        "targets": [{
          "expr": "sum(rate(kafka_server_broker_topic_metrics_messages_in_total[5m])) by (topic)",
          "legendFormat": "{{topic}}",
          "refId": "A"
        }],
        "yaxes": [
          {"format": "ops", "label": "Messages/sec"},
          {"format": "short"}
        ]
      },
      {
        "id": 6,
        "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
        "type": "graph",
        "title": "Bytes In/Out Rate",
        "targets": [
          {
            "expr": "sum(rate(kafka_server_broker_topic_metrics_bytes_in_total[5m]))",
            "legendFormat": "Bytes In",
            "refId": "A"
          },
          {
            "expr": "sum(rate(kafka_server_broker_topic_metrics_bytes_out_total[5m]))",
            "legendFormat": "Bytes Out",
            "refId": "B"
          }
        ],
        "yaxes": [
          {"format": "Bps", "label": "Bytes/sec"},
          {"format": "short"}
        ]
      },
      {
        "id": 7,
        "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
        "type": "graph",
        "title": "Consumer Lag",
        "targets": [{
          "expr": "sum(kafka_consumergroup_lag) by (consumergroup, topic)",
          "legendFormat": "{{consumergroup}} - {{topic}}",
          "refId": "A"
        }],
        "yaxes": [
          {"format": "short", "label": "Lag (messages)"},
          {"format": "short"}
        ]
      },
      {
        "id": 8,
        "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
        "type": "graph",
        "title": "Request Rate by Type",
        "targets": [{
          "expr": "sum(rate(kafka_network_request_metrics_total_time_ms_count[5m])) by (request)",
          "legendFormat": "{{request}}",
          "refId": "A"
        }],
        "yaxes": [
          {"format": "reqps", "label": "Requests/sec"},
          {"format": "short"}
        ]
      }
    ]
  }
}